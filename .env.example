# Copy to .env locally, or add these variables in your hosting dashboard.
# Never commit .env. This file contains placeholders, not credentials.

# Production requires a stable public HTTPS origin, without a path or trailing slash.
NFC_ENV=production
NFC_PUBLIC_ORIGIN=https://cards.example.com

# Absolute SQLite path on a persistent, writable volume. Photos are stored in this DB.
NFC_DB=/data/nfc.sqlite3

# Bind inside a container / service. Publish through your hosting HTTPS reverse proxy.
NFC_HOST=0.0.0.0
NFC_PORT=8080

# Optional: Gunicorn workers (single host, shared local SQLite volume).
NFC_WORKERS=2
# Optional: authenticated session lifetime, 1–90 days.
NFC_SESSION_DAYS=7
# Set to 1 ONLY when exactly one trusted reverse proxy is the only network ingress.
NFC_TRUST_PROXY=0

# Vercel: use a dedicated PostgreSQL database, never NFC_DB or /tmp SQLite.
# Add DATABASE_URL securely in Vercel (Neon integration supplies this automatically).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# NFC_PUBLIC_ORIGIN may be omitted on Vercel: its production domain is used.
